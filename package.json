    "bootstrap": "^5.3.8",
    "moment": "^2.30.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "redux-logger": "^3.0.6",
    "socket.io-client": "^4.7.5",
    "styled-components": "^6.5.3",
    "sweetalert2": "^11.26.25",
