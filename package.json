    "@types/redux-logger": "^3.0.13",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "sass": "^1.103.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
